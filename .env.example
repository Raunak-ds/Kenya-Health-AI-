# Database configuration (SQLite for zero-config dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./crophealth.db
# DATABASE_URL=postgresql://user:password@localhost:5432/crophealth

# Security & JWT Authentication
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Machine Learning Model & Artifacts
MODEL_PATH=artifacts/best_model.pt
IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.70
DEVICE=auto

# Storage & Image Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Weather Service Integration
WEATHER_PROVIDER=disabled
WEATHER_API_KEY=

# Localization & Preferences
DEFAULT_LANGUAGE=en
APP_NAME=Kenya Crop Health AI
APP_VERSION=2.0.0
DEBUG=false
